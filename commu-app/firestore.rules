rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // ─── Friend Requests ──────────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      // Allow list queries: fromUserId == me OR toUserId == me
      // (resource.data is NOT available on list queries, so we allow any auth'd user
      //  to read and filter client-side – the service already filters by toUserId/fromUserId)
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
    }

    // ─── Friendships ──────────────────────────────────────────────────────────
    match /friendships/{friendshipId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid in request.resource.data.userIds;
      allow delete: if isAuth() && request.auth.uid in resource.data.userIds;
    }

    // ─── Conversations & Messages ─────────────────────────────────────────────
    match /conversations/{convId} {
      // Allow list queries (e.g. where participants array-contains userId)
      // resource.data is unavailable on list queries, so we allow any auth'd user.
      // Security is enforced by always querying with where('participants','array-contains', uid)
      allow read: if isAuth();
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    // ─── Posts ────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // Anyone logged in can read all posts (real-time feed)
      allow read: if isAuth();

      // Only the author can create their own posts
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;

      // Any authenticated user can update a post (for likeCount, shareCount, etc.)
      allow update: if isAuth();

      // Only the post owner can delete their own post
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;

      // Likes subcollection
      match /likes/{userId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }

      // Comments subcollection — any logged-in user can read & comment
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      }
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Allow list queries for notifications
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuth() && resource.data.recipientId == request.auth.uid;
    }

    // ─── Calls ────────────────────────────────────────────────────────────────
    match /calls/{callId} {
      // Allow list queries for incoming calls
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.callerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );
    }
  }
}
